{
  "name": "dsh-subagent-remote",
  "version": "0.9.2-rc.3",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "description": "远端子智能体：把一次性任务派发到另一台机器的 DSH（SSH + ACP），支持多主机、热加载配置与 JSON 覆盖层。Remote subagent provider for DeepSeek Harness: dispatches a one-shot subagent activation to a DSH acp profile on another machine over SSH (ACP over stdio), with a fail-closed permission policy, a unified multi-host tool, and an IM-style plugin configuration page backed by a JSON overlay.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "subagent",
    "acp",
    "ssh",
    "remote"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "lib",
    "assets/icon.png",
    "assets/icon-128.png",
    "assets/screenshots",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check index.js && node --check lib/acp.js && node --check lib/policy.js && node --check lib/tool.js && node --check lib/settings.js && node --check lib/client.js",
    "test": "node test/policy-selftest.mjs && node test/tool-selftest.mjs && node test/config-selftest.mjs && node test/settings-selftest.mjs && node test/transport-selftest.mjs",
    "test:policy": "node test/policy-selftest.mjs",
    "test:tool": "node test/tool-selftest.mjs",
    "test:config": "node test/config-selftest.mjs",
    "test:settings": "node test/settings-selftest.mjs",
    "test:transport": "node test/transport-selftest.mjs",
    "prepublishOnly": "npm run check && npm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "plugin": {
      "name": "dsh-subagent-remote"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dsh": "0.2.1-rc.3",
      "dshReleases": {
        "0.2.1-rc.3": "compatible",
        "0.2.1-rc.2": "compatible"
      },
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "author": "Xingchen Zhao <endlass@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endlass/dsh-subagent-remote.git"
  },
  "homepage": "https://github.com/endlass/dsh-subagent-remote#readme",
  "bugs": {
    "url": "https://github.com/endlass/dsh-subagent-remote/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "icon": "./assets/icon.png"
}
