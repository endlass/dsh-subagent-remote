{
  "name": "dsh-subagent-remote",
  "version": "0.9.2-rc.9",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.png",
    "./package.json": "./package.json"
  },
  "description": "远端子智能体：把一次性子任务经 SSH（ACP）派发到另一台机器的 DSH 执行，只把 closing message 返回本地父会话。Remote one-shot subagent provider for DeepSeek Harness with multi-host config and fail-closed permissions.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "cordis-plugin",
    "subagent",
    "remote",
    "ssh",
    "acp",
    "remote-execution"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "files": [
    "index.js",
    "lib",
    "assets/icon.png",
    "assets/icon-128.png",
    "assets/screenshots",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "scripts": {
    "check": "node --check index.js && node --check lib/acp.js && node --check lib/policy.js && node --check lib/tool.js && node --check lib/settings.js && node --check lib/runs.js && node --check lib/journal.js && node --check lib/client.js",
    "test": "node test/policy-selftest.mjs && node test/tool-selftest.mjs && node test/config-selftest.mjs && node test/settings-selftest.mjs && node test/runs-selftest.mjs && node test/journal-selftest.mjs && node test/transport-selftest.mjs && node test/client-contract-selftest.mjs",
    "test:policy": "node test/policy-selftest.mjs",
    "test:tool": "node test/tool-selftest.mjs",
    "test:config": "node test/config-selftest.mjs",
    "test:settings": "node test/settings-selftest.mjs",
    "test:runs": "node test/runs-selftest.mjs",
    "test:journal": "node test/journal-selftest.mjs",
    "test:transport": "node test/transport-selftest.mjs",
    "prepublishOnly": "npm run check && npm test",
    "test:client": "node test/client-contract-selftest.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "author": "Xingchen Zhao <endlass@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endlass/dsh-subagent-remote.git"
  },
  "homepage": "https://github.com/endlass/dsh-subagent-remote#readme",
  "bugs": {
    "url": "https://github.com/endlass/dsh-subagent-remote/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "icon": "./assets/icon.png"
}
